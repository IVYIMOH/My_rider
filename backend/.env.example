PORT=8080
DB_PATH=./sipi.db

# Demo data (admin@sipirider.com/admin1234 plus fake users, drivers and rides).
ALLOW_SEED=true                   # required for local dev and scripts/verify-security-fixes.sh; never set in production

# REQUIRED in production. Generate with: openssl rand -hex 32
# With NODE_ENV=production the server refuses to boot if this is unset or left
# at the placeholder below. In development an unset value falls back to a dev
# secret with a startup warning.
JWT_SECRET=change-this-to-a-random-secret

# Set to "production" on deployed environments. Enables the JWT_SECRET check
# above and makes an unconfigured SMS gateway a hard error instead of a
# console-only fallback.
NODE_ENV=development

# Base URL used to build verification links in emails (set to the deployed admin URL in production)
PUBLIC_BASE_URL=http://localhost:5174
VERIFY_TOKEN_TTL_MIN=60

# Gmail SMTP for verification emails.
# Note: Gmail requires an App Password (Google Account > Security > 2-Step Verification > App passwords),
# not the account password, when 2-Step Verification is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=my.sipi.rider@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=SipiRider <my.sipi.rider@gmail.com>

# ---- Phone verification ----
# MTN (Uganda) Number Verification. Fill in the OAuth client id/secret or the
# subscription key (depending on which auth style your MTN product uses), plus
# the token/verify URLs from the portal (verify URL may contain {msisdn}).
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=
MTN_SUBSCRIPTION_KEY=
MTN_TOKEN_URL=
MTN_VERIFY_URL=

# Safaricom Daraja - Query Customer Details (Kenya). DARAJA_PUBLIC_CERT is the
# path to the M-Pesa public certificate PEM used to encrypt the initiator password.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_TOKEN_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
DARAJA_QUERY_URL=https://sandbox.safaricom.co.ke/v1/payments/query/v1/queryCustomerDetails
DARAJA_SHORTCODE=
DARAJA_INITIATOR_NAME=
DARAJA_INITIATOR_PASSWORD=
DARAJA_PUBLIC_CERT=

# ---- Phone login (OTP) ----
# Login is two-step: POST /api/auth/phone-login sends a 6-digit code,
# POST /api/auth/phone-login/verify exchanges it for a JWT.
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5

# SMS-send rate limits (fixed window, in-memory — resets on restart and is not
# shared across processes; move to Redis before running more than one instance).
OTP_REQUESTS_PER_PHONE_HOUR=5     # texts to one number per hour, whoever asks
OTP_COOLDOWN_SECONDS=60           # minimum gap between texts to one number
OTP_REQUESTS_PER_IP_HOUR=20       # total sends from one client, across numbers
OTP_VERIFY_PER_PHONE_HOUR=20      # code submissions per number per hour

# Outbound SMS gateway used to deliver login codes. Unconfigured, codes print
# to the server console in development; in production an unconfigured gateway
# is a startup-time error. Adapt sendViaGateway() in src/lib/sms.ts to your
# provider (Africa's Talking, Twilio, MTN SMS).
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=SipiRider

# Development bypass: PHONE_MOCK=true skips the MTN/Daraja operator lookup and
# returns the OTP in the API response so you can log in without an SMS gateway.
# The OTP step itself still runs. MUST be false/removed in production.
PHONE_MOCK=true


