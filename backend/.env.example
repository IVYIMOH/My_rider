PORT=8080
DB_PATH=./sipi.db
JWT_SECRET=change-this-to-a-random-secret
# Base URL used to build verification links in emails (set to the deployed admin URL in production)
PUBLIC_BASE_URL=http://localhost:5174
VERIFY_TOKEN_TTL_MIN=60

# Gmail SMTP for verification emails.
# Note: Gmail requires an App Password (Google Account > Security > 2-Step Verification > App passwords),
# not the account password, when 2-Step Verification is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=my.sipi.rider@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=SipiRider <my.sipi.rider@gmail.com>
